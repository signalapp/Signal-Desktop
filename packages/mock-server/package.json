{
  "name": "@signalapp/mock-server",
  "packageManager": "pnpm@10.18.1",
  "version": "26.0.0",
  "description": "Mock Signal Server for writing tests",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "protos/compiled.js",
    "protos/compiled.d.ts",
    "certs"
  ],
  "scripts": {
    "watch": "npm run build:tsc -- -w",
    "build:tsc": "tsc",
    "build:protobuf": "protopiler --module cjs --output protos/compiled.js --typedefs protos/compiled.d.ts protos",
    "build": "npm run build:protobuf && npm run build:tsc",
    "format": "pprettier --write '**/*.ts'",
    "mocha": "mocha test/**/*-test.js",
    "lint:prettier": "pprettier --check '**/*.ts'",
    "lint": "npm run lint:prettier",
    "test": "npm run mocha && npm run lint",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/signalapp/Mock-Signal-Server.git"
  },
  "keywords": [
    "mock",
    "signal",
    "server"
  ],
  "author": {
    "name": "Open Whisper Systems",
    "email": "support@signal.org"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/signalapp/Mock-Signal-Server/issues"
  },
  "homepage": "https://github.com/signalapp/Mock-Signal-Server#readme",
  "dependencies": {
    "@indutny/parallel-prettier": "^3.0.0",
    "@indutny/protopiler": "4.0.0",
    "@signalapp/libsignal-client": "0.100.0",
    "@tus/file-store": "^1.5.1",
    "@tus/server": "^1.10.2",
    "debug": "^4.4.3",
    "is-plain-obj": "3.0.0",
    "micro": "^9.4.1",
    "microrouter": "^3.1.3",
    "prettier": "^3.8.3",
    "type-fest": "^4.26.1",
    "url-pattern": "^1.0.3",
    "uuid": "^8.3.2",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/long": "^4.0.2",
    "@types/micro": "^7.3.7",
    "@types/microrouter": "^3.1.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.0",
    "@types/uuid": "^8.3.4",
    "@types/ws": "^8.18.1",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@types/ws": "patches/@types__ws.patch"
    }
  }
}
